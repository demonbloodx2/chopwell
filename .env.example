# Supabase Configuration
# For local development: Run `npm run supabase:start` and copy the "Publishable" key from the output
# For production: Copy this to .env.production and fill in your cloud project values

# Supabase URL
# Local: http://127.0.0.1:54321
# Production: https://your-project.supabase.co
SUPABASE_URL=http://127.0.0.1:54321

# Supabase Publishable/Anon Key (public key, safe for client-side use)
# Local: Get this from the output of `npm run supabase:start`
#        Look for "Publishable │ sb_publishable_..."
# Production: Get this from your Supabase project settings (anon/public key)
# NEVER commit the service role key to the repository
SUPABASE_ANON_KEY=your-publishable-key-here

# Environment
ENVIRONMENT=local
