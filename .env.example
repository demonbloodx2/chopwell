# Supabase Configuration
# For local development: Use the local Supabase credentials (run `supabase start` first)
# For production: Copy this to .env.production and fill in your cloud project values

# Supabase URL
# Local: http://127.0.0.1:54321
# Production: https://your-project.supabase.co
SUPABASE_URL=http://127.0.0.1:54321

# Supabase Anon Key (public key, safe for client-side use)
# Local: The key below is the standard local Supabase anon key
# Production: Replace with your cloud project's anon key
# NEVER commit the service role key to the repository
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Environment
ENVIRONMENT=local
