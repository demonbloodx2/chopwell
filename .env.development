# Supabase Local Development Configuration
# Uses local Supabase instance (run `npm run supabase:start` first)

# Local Supabase URL (default port 54321)
SUPABASE_URL=http://127.0.0.1:54321

# Local Supabase Publishable Key (safe to commit for local dev)
# This is the "Publishable" key from `npm run supabase:start` output
SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Environment
ENVIRONMENT=local
